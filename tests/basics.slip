; integers, arithmetic and comparison
(print (+ 1 2 3) (- 10 4 1) (- 5) (* 2 3 4) (/ 7 2) (/ -7 2) (% -7 2) (% 7 -2))
(print (= 1 1 1) (= 1 2) (!= 1 2) (< 1 2 3) (< 1 3 2) (<= 2 2) (> 3 2 1) (>= 1 2))
(print (< "abc" "abd") (> "b" "abc") (= "x" "x"))
# truthiness is Python-like: nil false 0 "" [] {} are falsy
(print (not nil) (not false) (not 0) (not "") (not []) (not {}) (not 1) (not "a"))
(print (and 1 2 3) (and 1 nil 3) (or nil 0 "x") (or) (and))
; multi-branch if (like if/elif/else)
(def sign [n] (if (< n 0) "neg" (= n 0) "zero" "pos"))
(print (sign -5) (sign 0) (sign 5))
(print (if false 1))
; let is sequential
(let [x 2 y (* x 10)] (print x y))
(do (print "a") (print "b"))
; tail recursion runs in constant stack and memory
(def count-to [i n] (if (= i n) i (count-to (+ i 1) n)))
(print (count-to 0 1000000))
; deep non-tail recursion
(def depth [n] (if (= n 0) 0 (+ 1 (depth (- n 1)))))
(print (depth 100000))
(def fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(print (fib 20))
(print (type 1) (type "s") (type []) (type {}) (type nil) (type true) (type fib) (type print) (type stdout))
(print (int "42") (int " -7 ") (int "+3") (int true) (str 1 "a" [1 "b"]) (repr "a\"b\n"))
(print args)
