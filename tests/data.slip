; lists
(def xs [1 2 3 4 5])
(print xs (len xs) (first xs) (last xs) (rest xs) (get xs 0) (get xs -1) (get xs 9) (get xs 9 "none"))
(print (push xs 6 7) xs)
(print (+ [1 2] [3] []) (slice xs 1 3) (slice xs -2) (slice xs 3 1) (slice xs 0 nil))
(print (range 5) (range 2 5) (range 10 0 -3) (range 0))
(print (map (fn [x] (* x x)) xs) (filter (fn [x] (% x 2)) xs))
(print (reduce + xs) (reduce + xs 100) (reduce + []) (reverse xs))
(print (in 3 xs) (in 9 xs) (= [1 [2 3]] [1 [2 3]]) (= [1 2] [1 2 3]))
(print [] (first []) (rest []) [nil true false])
; strings
(def s "Hello, World")
(print s (len s) (get s 0) (get s -1) (slice s 7) (+ s "!" "?") (reverse "abc"))
(print (in "World" s) (in "world" s) (split "a,b,,c" ",") (split "  one two\tthree\n"))
(print (join ["a" "b" "c"] ", ") (join [1 2 3]) (strip "  padded \n"))
(print (repr "tab\tquote\"backslash\\") "esc:\e[0m")
; hashes keep insertion order
(def h {"name": "slip", "version": 1, 42: "answer"})
(print h (len h) (get h "name") (get h 42) (get h "nope") (get h "nope" 0))
(print (put h "version" 2) (put h "new" [1 2]) (del h "name") h)
(print (keys h) (values h) (in "name" h) (in "zzz" h))
(print (= {"a" 1 "b" 2} {"b" 2 "a" 1}) (= {"a" 1} {"a" 2}) (hash "k" "v") {})
(print (get (get {"a" {"b" [10 20]}} "a") "b"))
(def big (reduce (fn [acc i] (put acc i (* i i))) (range 1000) {}))
(print (len big) (get big 999) (get big 500))
