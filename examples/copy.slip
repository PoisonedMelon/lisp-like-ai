; Copy a file chunk by chunk:  ./slip examples/copy.slip SRC DEST
(if (!= (len args) 2)
  (do (write stderr "usage: copy.slip SRC DEST\n") (exit 2)))

(def copy [src dst total]
  (let [chunk (read src 65536)]
    (if chunk
      (copy src dst (+ total (write dst chunk)))
      total)))

(let [src (open (get args 0))
      dst (open (get args 1) "w")]
  (if (not src)
    (do (write stderr "cannot open " (get args 0) "\n") (exit 1)))
  (print "copied" (copy src dst 0) "bytes")
  (close src)
  (close dst))
